{
    email {$ACME_EMAIL}
    admin off
}

(common_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

{$HUB_DOMAIN} {
    import common_headers
    encode zstd gzip

    route {
        redir /pms /pms/ 308
        handle_path /pms/* {
            reverse_proxy pms:80 {
                header_up X-Forwarded-Prefix /pms
            }
        }

        redir /totem /totem/ 308
        handle_path /totem/* {
            reverse_proxy totem-api:3080 {
                header_up X-Forwarded-Prefix /totem
            }
        }

        redir /food /food/ 308
        handle_path /food/* {
            reverse_proxy totem-food:3088 {
                header_up X-Forwarded-Prefix /food
            }
        }

        # Face Scanner é um módulo independente do Totem. A raiz e as APIs
        # permanecem no próprio serviço FastAPI; a tela /totem/face-scanner-test.html
        # é apenas a homologação da integração Totem -> Face Scanner.
        redir /face-scanner /face-scanner/ 308
        handle_path /face-scanner/* {
            reverse_proxy face-scanner:8091 {
                header_up X-Forwarded-Prefix /face-scanner
            }
        }

        handle {
            reverse_proxy hub-core:80
        }
    }
}
