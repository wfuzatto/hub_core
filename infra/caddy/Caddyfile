{
    email {$ACME_EMAIL}
    admin off
}

(common_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

{$HUB_DOMAIN} {
    import common_headers
    encode zstd gzip

    route {
        redir /pms /pms/ 308
        handle_path /pms/* {
            reverse_proxy pms:80 {
                header_up X-Forwarded-Prefix /pms
            }
        }

        redir /totem /totem/ 308
        handle_path /totem/* {
            reverse_proxy totem-api:3080 {
                header_up X-Forwarded-Prefix /totem
            }
        }

        # A raiz pública do Face Scanner abre a tela rica de homologação do Totem,
        # que exibe os rostos detectados/alinhados ao final. As rotas técnicas
        # /face-scanner/api/* e /face-scanner/static/* continuam indo diretamente
        # para o serviço FastAPI abaixo.
        redir /face-scanner /totem/face-scanner-test.html 308
        redir /face-scanner/ /totem/face-scanner-test.html 308
        handle_path /face-scanner/* {
            reverse_proxy face-scanner:8091 {
                header_up X-Forwarded-Prefix /face-scanner
            }
        }

        handle {
            reverse_proxy hub-core:80
        }
    }
}
