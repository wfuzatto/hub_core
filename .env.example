# Stack
STACK_NAME=hub_core
TZ=America/Sao_Paulo

CADDY_IMAGE=caddy:2.11.4-alpine
MYSQL_IMAGE=mysql:8.4.11

# Edge / TLS
ACME_EMAIL=infra@example.com
HUB_DOMAIN=hub.example.com
TOTEM_DOMAIN=totem.example.com
FACE_SCANNER_DOMAIN=face.example.com

TOTEM_LOCAL_BIND=127.0.0.1
TOTEM_LOCAL_PORT=3080
HUB_LOCAL_BIND=127.0.0.1
HUB_LOCAL_PORT=3083
PMS_LOCAL_BIND=127.0.0.1
PMS_LOCAL_PORT=3084
TOTEM_FOOD_LOCAL_BIND=127.0.0.1
TOTEM_FOOD_LOCAL_PORT=3085
PAYMENT_LOCAL_BIND=127.0.0.1
PAYMENT_LOCAL_PORT=3086

PMS_PUBLIC_HOST=192.168.51.135
PMS_PUBLIC_PATH=/pms

# MySQL
MYSQL_DATABASE=hotel_reservas
MYSQL_USER=hub_app
MYSQL_PASSWORD=CHANGE_ME_HUB_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD

# PMS Hotelaria
PMS_DB_HOST=mysql
PMS_DB_PORT=3306
PMS_DB_NAME=hotel_reservas
PMS_DB_USER=pms_app
PMS_DB_PASSWORD=AUTO_GENERATED_BY_PREPARE_PMS
PMS_ADMIN_EMAIL=admin@pms.local
PMS_ADMIN_PASSWORD=AUTO_GENERATED_BY_PREPARE_PMS

# Face Scanner
FACE_SCANNER_API_KEY=CHANGE_ME_FACE_SCANNER_API_KEY
FACE_SCANNER_MAX_UPLOAD_MB=10
FACE_SCANNER_MIN_BLUR_SCORE=30
FACE_SCANNER_GPU_DEVICE=0

# Totem hotel
TOTEM_ADMIN_PASSWORD=CHANGE_ME_TOTEM_ADMIN_PASSWORD
TOTEM_PAYMENT_MERCHANT_ID=totem_hotel
TOTEM_PAYMENT_TERMINAL_ID=totem-hotel-01
PAYMENT_UI_WAIT_MS=90000
PAYMENT_UI_POLL_MS=750

# NFC / fechaduras BIS-BeTech. Produção usa bis_api e bloqueia se faltar configuração.
# mock é permitido somente para testes explícitos e não grava uma pulseira física.
HOTEL_CARD_PROVIDER=bis_api
# Ex.: http://192.168.51.50:8765 (IP do Windows que executa bis_api + ACR122U)
BIS_API_URL=
# Deve ser exatamente o mesmo segredo de BisApi:RequireWriteChallenge no Windows.
# Nunca coloque o valor real no Git ou no navegador.
# Não é o HPASS: HPASS obrigatório fica somente em BeTech57.HotelPassword no Windows.
BIS_API_WRITE_CONFIRMATION=
BIS_API_TIMEOUT_MS=15000
# Politica operacional da fechadura; preencher com os horarios reais do hotel.
# Formato HH:MM. Exemplos apenas ilustrativos: 14:00 / 12:00.
HOTEL_ACCESS_CHECKIN_TIME=
HOTEL_ACCESS_CHECKOUT_TIME=
# DateTimeOffset exigido pelo bis_api. Exemplo para horario de Brasilia: -03:00.
HOTEL_ACCESS_UTC_OFFSET=

# Totem Food: pagamentos sempre passam por api_pagamento no compose de producao.
TOTEM_FOOD_PAYMENT_SYNC_INTERVAL_MS=1000
TOTEM_FOOD_FISCAL_PROVIDER=mock
TOTEM_FOOD_FISCAL_PROVIDER_URL=
TOTEM_FOOD_FISCAL_PROVIDER_TOKEN=
TOTEM_FOOD_IDLE_AD_SECONDS=45
TOTEM_FOOD_ABANDONED_CART_SECONDS=120
TOTEM_FOOD_STORE_NAME=Totem Food
TOTEM_FOOD_STORE_TAX_ID=

# API Pagamento - unica fronteira financeira dos modulos.
PAYMENT_API_KEY=CHANGE_ME_PAYMENT_API_KEY
PAYMENT_PROVIDER_CASH=cash
PAYMENT_PROVIDER_PIX=mock
PAYMENT_PROVIDER_DEBIT=mock
PAYMENT_PROVIDER_CREDIT=mock
PAYMENT_MOCK_AUTO_APPROVE=true
PAYMENT_MOCK_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_MOCK_WEBHOOK_SECRET

# Fila duravel / concorrencia. PIX e APIs cloud processam em paralelo; o mesmo
# terminal_id/pinpad_id e serializado pelo gateway.
PAYMENT_JOB_POLL_MS=250
PAYMENT_JOB_CONCURRENCY=8
PAYMENT_JOB_MAX_ATTEMPTS=12
PAYMENT_JOB_STALE_SECONDS=120
PAYMENT_JOB_MAX_BACKOFF_SECONDS=300

# Bridges de adquirentes. Trocar adquirente deve exigir mudanca somente aqui/adapters.
PAYMENT_GETNET_BRIDGE_URL=
PAYMENT_GETNET_BRIDGE_TOKEN=
PAYMENT_GETNET_WEBHOOK_SECRET=
PAYMENT_REDE_BRIDGE_URL=
PAYMENT_REDE_BRIDGE_TOKEN=
PAYMENT_REDE_WEBHOOK_SECRET=
PAYMENT_PAGBANK_BRIDGE_URL=
PAYMENT_PAGBANK_BRIDGE_TOKEN=
PAYMENT_PAGBANK_WEBHOOK_SECRET=

# Backoffice / conciliacao
PAYMENT_BACKOFFICE_WEBHOOK_URL=
PAYMENT_BACKOFFICE_WEBHOOK_SECRET=
PAYMENT_OUTBOX_POLL_MS=5000
PAYMENT_OUTBOX_MAX_ATTEMPTS=20
PAYMENT_HTTP_TIMEOUT_MS=15000

# Backup
BACKUP_RETENTION_DAYS=30
