# Stack
STACK_NAME=hub_core
TZ=America/Sao_Paulo

# Imagens-base fixadas por versão. Após homologação do servidor, os digests SHA256
# também devem ser congelados no release de produção.
CADDY_IMAGE=caddy:2.11.4-alpine
MYSQL_IMAGE=mysql:8.4.11

# Edge / TLS
# Em servidores que já possuem Caddy/NGINX no host, scripts/update.sh usa
# host-edge por padrão e NÃO tenta ocupar 80/443.
ACME_EMAIL=infra@example.com
HUB_DOMAIN=hub.example.com
TOTEM_DOMAIN=totem.example.com
FACE_SCANNER_DOMAIN=face.example.com

# Publicações somente em loopback usadas pelo edge já existente no host.
TOTEM_LOCAL_BIND=127.0.0.1
TOTEM_LOCAL_PORT=3080
HUB_LOCAL_BIND=127.0.0.1
HUB_LOCAL_PORT=3083
PMS_LOCAL_BIND=127.0.0.1
PMS_LOCAL_PORT=3084

# Publicação do PMS no mesmo HTTPS do Totem em host-edge.
# URL padrão: https://192.168.51.135/pms/
PMS_PUBLIC_HOST=192.168.51.135
PMS_PUBLIC_PATH=/pms

# MySQL único do HUB Core + PMS (somente rede Docker; não publica 3306 no host).
# A plataforma usa um único schema operacional: hotel_reservas.
MYSQL_DATABASE=hotel_reservas
MYSQL_USER=hub_app
MYSQL_PASSWORD=CHANGE_ME_HUB_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD

# PMS Hotelaria
# scripts/prepare_pms.sh mantém PMS_DB_NAME sincronizado com MYSQL_DATABASE,
# cria o usuário pms_app e gera senha forte quando necessário.
PMS_DB_HOST=mysql
PMS_DB_PORT=3306
PMS_DB_NAME=hotel_reservas
PMS_DB_USER=pms_app
PMS_DB_PASSWORD=AUTO_GENERATED_BY_PREPARE_PMS
PMS_ADMIN_EMAIL=admin@pms.local
PMS_ADMIN_PASSWORD=AUTO_GENERATED_BY_PREPARE_PMS

# Face Scanner
FACE_SCANNER_API_KEY=CHANGE_ME_FACE_SCANNER_API_KEY
FACE_SCANNER_MAX_UPLOAD_MB=10
# Homologação: 30 funcionou melhor com webcams boas sem ficar excessivamente rígido.
# Ajuste depois com a câmera física do Totem a partir de amostras reais.
FACE_SCANNER_MIN_BLUR_SCORE=30
FACE_SCANNER_GPU_DEVICE=0

# Totem
TOTEM_ADMIN_PASSWORD=CHANGE_ME_TOTEM_ADMIN_PASSWORD

# Backup
BACKUP_RETENTION_DAYS=30
